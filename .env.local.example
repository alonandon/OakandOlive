# Google Workspace account the contact form sends email through.
# Requires 2-Step Verification enabled and an App Password (not your regular password) —
# generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=dr.alex@oakolivehealth.com
GMAIL_APP_PASSWORD=

# Optional: where contact form submissions are delivered. Defaults to GMAIL_USER if unset.
CONTACT_TO_EMAIL=dr.alex@oakolivehealth.com
